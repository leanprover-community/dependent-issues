{
	"name": "dependent-issues",
	"version": "0.0.0-development",
	"private": true,
	"main": "lib/action.js",
	"scripts": {
		"build": "tsc",
		"format": "prettier --write **/*.ts",
		"lint": "eslint src/**/*.ts",
		"prepackage": "rimraf -rf dist && rimraf -rf lib && yarn build",
		"package": "ncc build --source-map --license licenses.txt",
		"test": "jest --passWithNoTests"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/leanprover-community/dependent-issues.git"
	},
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@actions/core": "^2.0.3",
		"@actions/github": "^7.0.0",
		"dequal": "^2.0.2",
		"issue-regex": "^3.1.0",
		"lodash.uniqby": "^4.7.0"
	},
	"devDependencies": {
		"@types/jest": "^27.5.0",
		"@types/js-yaml": "^4.0.5",
		"@types/lodash.uniqby": "^4.7.7",
		"@types/node": "^17.0.43",
		"@typescript-eslint/parser": "^5.30.5",
		"@vercel/ncc": "^0.34.0",
		"eslint": "^8.19.0",
		"eslint-config-prettier": "^8.5.0",
		"jest": "^27.5.1",
		"jest-environment-node": "^27.5.1",
		"js-yaml": "^4.1.0",
		"prettier": "^2.7.1",
		"rimraf": "^3.0.2",
		"ts-jest": "^27.1.4",
		"typescript": "^4.7.4"
	},
	"prettier": {
		"printWidth": 72,
		"useTabs": true,
		"singleQuote": true
	},
	"resolutions": {
		"@actions/github/undici": "^6.28.1"
	}
}
